// app/join/[sessionId]/page.tsx
// Drop this file at that exact path in your Next.js App Router project.
// Make sure you have @supabase/supabase-js installed:  npm install @supabase/supabase-js
// Add NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY to your .env.local

"use client";

import { useEffect, useState, useCallback } from "react";
import { createClient } from "@supabase/supabase-js";

// ─── Supabase client (browser-safe) ──────────────────────────────────────────
const supabase = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL!,
  process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY!
);

// ─── Types ────────────────────────────────────────────────────────────────────
interface PartyItem {
  id: string;
  session_id: string;
  name: string;
  quantity: number;
  price: number;
  added_by: string | null;
  notes: string | null;
  created_at: string;
}

// ─── Mock food items to cycle through when adding test items ─────────────────
const MOCK_FOODS = [
  { name: "Margherita Pizza", price: 14.99 },
  { name: "Truffle Fries", price: 8.5 },
  { name: "Caesar Salad", price: 11.0 },
  { name: "BBQ Chicken Wings", price: 13.5 },
  { name: "Mango Lassi", price: 5.99 },
  { name: "Garlic Naan", price: 3.5 },
  { name: "Butter Chicken", price: 16.99 },
  { name: "Cheese Burger", price: 12.5 },
];

// ─── Page ─────────────────────────────────────────────────────────────────────
export default function JoinGroupOrderPage({
  params,
}: {
  params: { sessionId: string };
}) {
  const { sessionId } = params;

  const [items, setItems] = useState<PartyItem[]>([]);
  const [loading, setLoading] = useState(true);
  const [adding, setAdding] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [guestName] = useState(() => `Guest ${Math.floor(Math.random() * 900) + 100}`);
  const [addedCount, setAddedCount] = useState(0);

  // ── Initial fetch ────────────────────────────────────────────────────────
  const fetchItems = useCallback(async () => {
    const { data, error } = await supabase
      .from("party_items")
      .select("*")
      .eq("session_id", sessionId)
      .order("created_at", { ascending: true });

    if (error) {
      setError("Couldn't load the cart. Please try refreshing.");
      console.error("fetchItems error:", error.message);
    } else {
      setItems(data ?? []);
    }
    setLoading(false);
  }, [sessionId]);

  // ── Real-time subscription ───────────────────────────────────────────────
  useEffect(() => {
    fetchItems();

    const channel = supabase
      .channel(`party-cart-${sessionId}`)
      .on(
        "postgres_changes",
        {
          event: "INSERT",
          schema: "public",
          table: "party_items",
          filter: `session_id=eq.${sessionId}`,
        },
        (payload) => {
          setItems((prev) => {
            const exists = prev.some((i) => i.id === payload.new.id);
            return exists ? prev : [...prev, payload.new as PartyItem];
          });
        }
      )
      .on(
        "postgres_changes",
        {
          event: "UPDATE",
          schema: "public",
          table: "party_items",
          filter: `session_id=eq.${sessionId}`,
        },
        (payload) => {
          setItems((prev) =>
            prev.map((i) => (i.id === payload.new.id ? (payload.new as PartyItem) : i))
          );
        }
      )
      .on(
        "postgres_changes",
        {
          event: "DELETE",
          schema: "public",
          table: "party_items",
          filter: `session_id=eq.${sessionId}`,
        },
        (payload) => {
          setItems((prev) => prev.filter((i) => i.id !== payload.old.id));
        }
      )
      .subscribe();

    return () => {
      supabase.removeChannel(channel);
    };
  }, [sessionId, fetchItems]);

  // ── Add test item ────────────────────────────────────────────────────────
  const handleAddTestItem = async () => {
    setAdding(true);
    const food = MOCK_FOODS[(addedCount) % MOCK_FOODS.length];

    const { error } = await supabase.from("party_items").insert({
      session_id: sessionId,
      name: food.name,
      quantity: 1,
      price: food.price,
      added_by: guestName,
      notes: null,
    });

    if (error) {
      console.error("Add item error:", error.message);
      setError("Couldn't add item. Make sure the party_items table exists in Supabase.");
    } else {
      setAddedCount((c) => c + 1);
    }
    setAdding(false);
  };

  // ── Derived ──────────────────────────────────────────────────────────────
  const subtotal = items.reduce((sum, i) => sum + i.price * i.quantity, 0);
  const itemCount = items.reduce((sum, i) => sum + i.quantity, 0);

  // ─────────────────────────────────────────────────────────────────────────
  return (
    <div className="min-h-screen bg-zinc-950 text-zinc-100 font-sans">

      {/* ── Sticky Download Banner ────────────────────────────────────────── */}
      <div className="sticky top-0 z-50 w-full bg-amber-500 px-4 py-3 flex items-center justify-between gap-3 shadow-lg shadow-amber-500/20">
        <div className="flex items-center gap-2.5 min-w-0">
          {/* Rasvia logo mark */}
          <div className="w-8 h-8 rounded-lg bg-black/20 flex items-center justify-center shrink-0">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="black" strokeWidth="2" strokeLinecap="round">
              <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" />
              <polyline points="9 22 9 12 15 12 15 22" />
            </svg>
          </div>
          <p className="text-black text-sm font-bold leading-snug truncate">
            The Rasvia app is faster.{" "}
            <span className="font-normal opacity-80">Priority seating + full menu.</span>
          </p>
        </div>
        <a
          href="https://rasvia.com/download"
          className="shrink-0 bg-black text-white text-xs font-bold px-4 py-2 rounded-full active:opacity-80 transition-opacity whitespace-nowrap"
        >
          Get App
        </a>
      </div>

      {/* ── Main Content ─────────────────────────────────────────────────── */}
      <div className="max-w-md mx-auto px-4 pb-32 pt-6">

        {/* Header */}
        <div className="mb-6">
          <div className="flex items-center gap-2 mb-1">
            <div className="w-2 h-2 rounded-full bg-emerald-400 animate-pulse" />
            <span className="text-emerald-400 text-xs font-bold uppercase tracking-widest">
              Live Party Cart
            </span>
          </div>
          <h1 className="text-2xl font-black text-zinc-100 tracking-tight">
            Group Order
          </h1>
          <p className="text-zinc-500 text-sm mt-1 font-mono truncate">
            Session #{sessionId.slice(0, 8)}…
          </p>
        </div>

        {/* Error Banner */}
        {error && (
          <div className="mb-4 px-4 py-3 rounded-2xl bg-red-500/10 border border-red-500/20 text-red-400 text-sm font-medium">
            {error}
          </div>
        )}

        {/* Loading */}
        {loading ? (
          <div className="flex flex-col items-center justify-center py-24 gap-4">
            <div className="w-8 h-8 rounded-full border-2 border-zinc-700 border-t-amber-500 animate-spin" />
            <p className="text-zinc-500 text-sm">Loading cart…</p>
          </div>
        ) : (
          <>
            {/* Cart Items */}
            {items.length === 0 ? (
              <div className="flex flex-col items-center justify-center py-20 gap-3 text-center">
                <div className="w-16 h-16 rounded-2xl bg-zinc-800 border border-white/5 flex items-center justify-center mb-2">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" className="text-zinc-600">
                    <circle cx="9" cy="21" r="1" /><circle cx="20" cy="21" r="1" />
                    <path d="M1 1h4l2.68 13.39a2 2 0 001.99 1.61h9.72a2 2 0 001.99-1.61L23 6H6" />
                  </svg>
                </div>
                <p className="text-zinc-400 font-semibold text-base">Cart is empty</p>
                <p className="text-zinc-600 text-sm">Tap the button below to add your first item.</p>
              </div>
            ) : (
              <div className="space-y-3 mb-6">
                {items.map((item) => (
                  <CartItemRow key={item.id} item={item} />
                ))}
              </div>
            )}

            {/* Cart Summary */}
            {items.length > 0 && (
              <div className="rounded-2xl bg-zinc-900 border border-white/5 p-4 mb-6 space-y-2">
                <div className="flex justify-between text-sm text-zinc-400">
                  <span>{itemCount} {itemCount === 1 ? "item" : "items"}</span>
                  <span className="font-semibold text-zinc-100">${subtotal.toFixed(2)}</span>
                </div>
                <p className="text-xs text-zinc-600">
                  Tax & fees calculated at checkout in the app.
                </p>
              </div>
            )}

            {/* Add Test Item Button */}
            <button
              onClick={handleAddTestItem}
              disabled={adding}
              className="w-full py-4 rounded-2xl bg-amber-500 active:bg-amber-400 disabled:bg-amber-500/50 text-black font-bold text-lg flex items-center justify-center gap-2 transition-colors shadow-lg shadow-amber-500/20"
            >
              {adding ? (
                <>
                  <div className="w-5 h-5 rounded-full border-2 border-black/30 border-t-black animate-spin" />
                  Adding…
                </>
              ) : (
                <>
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round">
                    <line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" />
                  </svg>
                  Add Test Item
                </>
              )}
            </button>

            <p className="text-center text-zinc-600 text-xs mt-3">
              You're browsing as <span className="text-zinc-400 font-medium">{guestName}</span>
            </p>
          </>
        )}
      </div>

      {/* ── Sticky Bottom CTA ─────────────────────────────────────────────── */}
      {!loading && (
        <div className="fixed bottom-0 left-0 right-0 z-40 p-4 bg-zinc-950/90 backdrop-blur-md border-t border-white/5">
          <div className="max-w-md mx-auto space-y-3">
            <a
              href="https://rasvia.com/download"
              className="block w-full py-4 rounded-2xl bg-zinc-800 border border-white/10 active:bg-zinc-700 text-zinc-200 font-bold text-base text-center transition-colors"
            >
              Open in Rasvia App →
            </a>
            <p className="text-center text-zinc-600 text-xs">
              Get the full menu, real-time updates &amp; priority seating.
            </p>
          </div>
        </div>
      )}
    </div>
  );
}

// ─── Cart Item Row ────────────────────────────────────────────────────────────
function CartItemRow({ item }: { item: PartyItem }) {
  return (
    <div className="flex items-start gap-4 p-4 rounded-2xl bg-zinc-900 border border-white/5 active:bg-zinc-800 transition-colors">
      {/* Quantity badge */}
      <div className="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center shrink-0">
        <span className="text-amber-400 font-black text-sm">{item.quantity}×</span>
      </div>

      {/* Details */}
      <div className="flex-1 min-w-0">
        <p className="text-zinc-100 font-semibold text-base leading-snug truncate">
          {item.name}
        </p>
        <div className="flex items-center gap-2 mt-0.5">
          {item.added_by && (
            <span className="text-zinc-500 text-xs truncate">
              by {item.added_by}
            </span>
          )}
          {item.notes && (
            <span className="text-zinc-600 text-xs truncate italic">
              · {item.notes}
            </span>
          )}
        </div>
      </div>

      {/* Price */}
      <div className="shrink-0 text-right">
        <p className="text-zinc-100 font-bold text-base">
          ${(item.price * item.quantity).toFixed(2)}
        </p>
        {item.quantity > 1 && (
          <p className="text-zinc-600 text-xs">${item.price.toFixed(2)} ea</p>
        )}
      </div>
    </div>
  );
}
